# lean python analyst image (heuristic coach by default; no Ollama/vision vendor)
# fairy-stockfish - linux binary for variant /analyze
FROM debian:bookworm-slim AS fs-builder
RUN apt-get update \
  && apt-get install -y --no-install-recommends make g++ \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /fs
COPY py_analyser/Fairy-Stockfish-fairy_sf_14/src/ ./
ARG TARGETARCH
RUN set -eux; \
  if [ "$TARGETARCH" = "arm64" ]; then ARCH=armv8; else ARCH=x86-64-modern; fi; \
  make -j"$(nproc)" build ARCH="$ARCH"; \
  mv stockfish /stockfish

FROM python:3.12-slim-bookworm
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY py_analyser/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY py_analyser/ ./
COPY --from=fs-builder /stockfish /usr/local/bin/stockfish
RUN chmod +x /usr/local/bin/stockfish

ENV PY_ANALYSER_HOST=0.0.0.0 \
    PY_ANALYSER_PORT=8001 \
    LLM_PROVIDER=heuristic \
    FAIRY_STOCKFISH_PATH=/usr/local/bin/stockfish \
    EXPLAIN_LOG=0

EXPOSE 8001
CMD ["python", "server.py"]

# python analyst + fairy-stockfish; optional diagram→FEN when vendor is mounted
FROM debian:bookworm-slim AS fs-builder
RUN apt-get update \
  && apt-get install -y --no-install-recommends make g++ \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /fs
COPY py_analyser/Fairy-Stockfish-fairy_sf_14/src/ ./
ARG TARGETARCH
RUN set -eux; \
  if [ "$TARGETARCH" = "arm64" ]; then ARCH=armv8; else ARCH=x86-64-modern; fi; \
  make -j"$(nproc)" build ARCH="$ARCH"; \
  mv stockfish /stockfish

FROM python:3.12-slim-bookworm
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates \
       libcairo2 \
       libgdk-pixbuf-2.0-0 \
       libgl1 \
       libglib2.0-0 \
       libgomp1 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY py_analyser/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
  && pip install --no-cache-dir \
       --index-url https://download.pytorch.org/whl/cpu \
       torch torchvision \
  && pip install --no-cache-dir \
       numpy \
       matplotlib \
       scikit-image \
       tqdm \
       pyffish \
       cairosvg \
       cairocffi \
       pyfastnoiselite \
       gdown \
       opencv-python-headless
COPY py_analyser/ ./
COPY --from=fs-builder /stockfish /usr/local/bin/stockfish
RUN chmod +x /usr/local/bin/stockfish

ENV PY_ANALYSER_HOST=0.0.0.0 \
    PY_ANALYSER_PORT=8001 \
    LLM_PROVIDER=heuristic \
    FAIRY_STOCKFISH_PATH=/usr/local/bin/stockfish \
    EXPLAIN_LOG=0

EXPOSE 8001
CMD ["python", "server.py"]
